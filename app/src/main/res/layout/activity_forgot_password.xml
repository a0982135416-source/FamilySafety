<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/constraintLayout_forgot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_blue">


    <!-- ========================================================= -->
    <!-- 01. 頂部 Header                                          -->
    <!-- 功能：顯示「返回」及「忘記密碼」                          -->
    <!-- 不使用額外圖片，避免缺少 back.png                         -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/textView_forgot_back"
        android:layout_width="44dp"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="‹"
        android:textColor="@android:color/white"
        android:textSize="36sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/textView_forgot_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="20dp"
        android:text="忘記密碼"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/textView_forgot_back"
        app:layout_constraintStart_toEndOf="@id/textView_forgot_back"
        app:layout_constraintTop_toTopOf="@id/textView_forgot_back" />


    <!-- ========================================================= -->
    <!-- 02. 主要內容區                                            -->
    <!-- 功能：放置忘記密碼頁面的所有內容                          -->
    <!-- 背景直接使用 app_background，不使用額外 drawable XML       -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView_forgot_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/app_background"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_forgot_back">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_background">


            <!-- ================================================= -->
            <!-- 03. 忘記密碼主圖                                  -->
            <!-- 使用現有 forgot_password.png                      -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/imageView_forgot_password"
                android:layout_width="240dp"
                android:layout_height="120dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="忘記密碼"
                android:scaleType="centerInside"
                android:src="@drawable/forgot_password"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- ================================================= -->
            <!-- 04. 主標題                                        -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/textView_forgot_reset_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:text="重設您的密碼"
                android:textColor="@color/title_blue"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imageView_forgot_password" />


            <!-- ================================================= -->
            <!-- 05. 主標題下方說明文字                            -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/textView_forgot_reset_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="32dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="請輸入您註冊時使用的電子信箱，&#10;我們將寄送一次性驗證碼。"
                android:textColor="#607D9D"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView_forgot_reset_title" />


            <!-- ================================================= -->
            <!-- 06. Email 輸入卡片                                -->
            <!-- 功能：輸入使用者註冊的 Email                      -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView_forgot_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#B8D9F5"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView_forgot_reset_desc">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">


                    <!-- ========================================= -->
                    <!-- 06-1. Email Icon                         -->
                    <!-- 使用現有 email.png                       -->
                    <!-- ========================================= -->

                    <ImageView
                        android:id="@+id/imageView_forgot_email"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="電子信箱"
                        android:scaleType="centerInside"
                        android:src="@drawable/email"
                        app:layout_constraintBottom_toBottomOf="@id/textView_forgot_email_label"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/textView_forgot_email_label" />


                    <!-- ========================================= -->
                    <!-- 06-2. Email 標題                         -->
                    <!-- ========================================= -->

                    <TextView
                        android:id="@+id/textView_forgot_email_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="電子信箱"
                        android:textColor="@color/title_blue"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imageView_forgot_email"
                        app:layout_constraintTop_toTopOf="parent" />


                    <!-- ========================================= -->
                    <!-- 06-3. Email 輸入框                       -->
                    <!-- ========================================= -->

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textInputLayout_forgot_email"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#B8D9F5"
                        app:boxStrokeWidth="1dp"
                        app:hintEnabled="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textView_forgot_email_label">


                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editText_forgot_email"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:hint="請輸入電子信箱"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/title_blue"
                            android:textColorHint="#9BAFC1"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- ========================================= -->
                    <!-- 06-4. Email 範例文字                     -->
                    <!-- ========================================= -->

                    <TextView
                        android:id="@+id/textView_forgot_email_example"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="例如：example@gmail.com"
                        android:textColor="#607D9D"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textInputLayout_forgot_email" />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- 07. 傳送驗證碼按鈕                               -->
            <!-- 之後 Server API 完成後再加入真正傳送功能          -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_forgot_send_code"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:backgroundTint="@color/primary_blue"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="傳送驗證碼"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardView_forgot_email" />


            <!-- ================================================= -->
            <!-- 08. Email 安全提示卡                              -->
            <!-- 不使用 info.png，避免使用你目前沒有的圖片         -->
            <!-- 使用文字符號 ⓘ 代替                              -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView_forgot_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                app:cardBackgroundColor="#E8F5FF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/button_forgot_send_code">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="13dp">


                    <!-- ========================================= -->
                    <!-- 08-1. Info 圖示                          -->
                    <!-- 使用文字，不需要任何圖片檔案              -->
                    <!-- ========================================= -->

                    <TextView
                        android:id="@+id/textView_forgot_info_icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="ⓘ"
                        android:textColor="@color/primary_blue"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <!-- ========================================= -->
                    <!-- 08-2. Info 說明文字                      -->
                    <!-- ========================================= -->

                    <TextView
                        android:id="@+id/textView_forgot_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="如果此 Email 已註冊，&#10;系統將寄送密碼重設驗證信。"
                        android:textColor="#0B5FA5"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@id/textView_forgot_info_icon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/textView_forgot_info_icon"
                        app:layout_constraintTop_toTopOf="@id/textView_forgot_info_icon" />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- 09. 返回登入                                     -->
            <!-- 不使用箭頭圖片，直接使用 ‹                       -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/textView_forgot_back_login"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="‹  返回登入"
                android:textColor="@color/primary_blue"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardView_forgot_info" />


            <!-- ================================================= -->
            <!-- 10. 底部裝飾圖                                   -->
            <!-- 使用剛才製作的透明 PNG                            -->
            <!-- 不使用 fitXY，避免房子與樹被壓扁                  -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/imageView_forgot_bottom_decor"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/forgot_password_botton"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView_forgot_back_login" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>