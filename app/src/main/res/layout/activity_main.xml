<?xml version="1.0" encoding="utf-8"?>

<!--
    ========================================================================
    家庭安全管理系統－主要 Activity Layout
    Family Safety Management System - Main Activity Layout
    ========================================================================

    MainActivity 負責：
    MainActivity is responsible for:

    1. Fragment 顯示區
       Fragment Container

    2. 共用底部導覽列
       Shared Bottom Navigation
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/constraintLayout_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/app_background"

    tools:context=".MainActivity">


    <!--
        ================================================================
        01. Fragment 顯示區
        Fragment Container
        ================================================================
    -->

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainerView_main_content"

        android:layout_width="0dp"
        android:layout_height="0dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView_main_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!--
        ================================================================
        02. 共用底部導覽列
        Shared Bottom Navigation
        ================================================================

        使用 Material BottomNavigationView 的正常高度。
        Use a standard height for Material BottomNavigationView.

        五個項目固定顯示 Icon + Label。
        All five items display both icon and label.
        ================================================================
    -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView_main_navigation"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:background="@android:color/white"

        app:elevation="8dp"

        app:itemIconSize="22dp"

        app:itemIconTint="@color/selector_nav_color"
        app:itemTextColor="@color/selector_nav_color"

        app:itemRippleColor="@android:color/transparent"
        app:itemActiveIndicatorStyle="@null"

        app:labelVisibilityMode="labeled"

        app:menu="@menu/bottom_navigation_menu"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>