<?xml version="1.0" encoding="utf-8"?>
<!--
    ========================================================================
    家庭安全管理系統 - 首頁 (Home / Dashboard) 佈局
    ========================================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2FAFF">

    <!-- 主要滾動內容區 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView_home_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <!-- ＝＝＝＝＝＝＝＝＝＝＝＝＝＝ A. Header 頂部區塊 ＝＝＝＝＝＝＝＝＝＝＝＝＝＝ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout_home_header"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:background="#1687E8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- 背景裝飾圖 -->
                <ImageView
                    android:id="@+id/imageView_home_header_background"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.1"
                    android:contentDescription="@null"
                    android:src="@drawable/background_top"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 選單按鈕 -->
                <ImageButton
                    android:id="@+id/imageButton_home_menu"
                    android:visibility="gone"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@android:color/white" />

                <!-- 使用者頭像 -->
                <FrameLayout
                    android:id="@+id/frameLayout_home_profile"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/auth_profile"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="44dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_circle_blue"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/user_w" />
                </FrameLayout>

                <!-- 歡迎文字標題 -->
                <TextView
                    android:id="@+id/textView_home_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="88dp"
                    android:text="@string/home_greeting"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textView_home_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_header_subtitle"
                    android:textColor="#DDEEFF"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="@id/textView_home_greeting"
                    app:layout_constraintTop_toBottomOf="@id/textView_home_greeting" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ＝＝＝＝＝＝＝＝＝＝＝＝＝＝ B. Family Status Card 家庭目前狀態 ＝＝＝＝＝＝＝＝＝＝＝＝＝＝ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView_home_status"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-22dp"
                app:cardBackgroundColor="#E8F5E9"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/constraintLayout_home_header"
                app:strokeColor="#C8D8CF"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/imageView_home_status_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/security_g"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView_home_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/home_status_safe"
                        android:textColor="#19B394"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imageView_home_status_icon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView_home_status_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_status_time_preview"
                        android:textColor="#8CA5BD"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ＝＝＝＝＝＝＝＝＝＝＝＝＝＝ C. Dashboard 2 x 2 網格卡片區 ＝＝＝＝＝＝＝＝＝＝＝＝＝＝ -->

            <!-- 第一排：環境安全 與 環境監測 -->
            <LinearLayout
                android:id="@+id/linearLayout_home_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                app:layout_constraintTop_toBottomOf="@id/cardView_home_status">

                <!-- D. Environment Safety Card 環境安全 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardView_home_safety"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFF7F7"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E4DADA"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp">

                        <FrameLayout
                            android:id="@+id/frameLayout_home_safety_icon_background"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_circle_red"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/flame"
                                app:tint="@android:color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/textView_home_safety_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/home_environment_safety"
                            android:textColor="#0B3D75"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/frameLayout_home_safety_icon_background"
                            app:layout_constraintStart_toEndOf="@id/frameLayout_home_safety_icon_background"
                            app:layout_constraintTop_toTopOf="@id/frameLayout_home_safety_icon_background" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_arrow"
                            android:textColor="#F0525C"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textView_home_safety_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="#FFEBEE"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:text="@string/home_location_kitchen"
                            android:textColor="#F0525C"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/frameLayout_home_safety_icon_background" />

                        <TextView
                            android:id="@+id/textView_home_safety_status_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#E8F5E9"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:text="@string/home_status_safe_label"
                            android:textColor="#19B394"
                            android:textSize="11sp"
                            app:layout_constraintBottom_toBottomOf="@id/textView_home_safety_location"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/textView_home_safety_location" />

                        <!-- 狀態詳細列表 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"
                            app:layout_constraintTop_toBottomOf="@id/textView_home_safety_location">

                            <!-- 瓦斯 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="1dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/gas_s" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:text="@string/home_gas"
                                    android:textColor="#8CA5BD"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/textView_home_gas_status_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_gas_off"
                                    android:textColor="#1687E8"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- 火焰 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="1dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/fire_s" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:text="@string/home_flame"
                                    android:textColor="#8CA5BD"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/textView_home_fire_status_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_status_none"
                                    android:textColor="#19B394"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- 人員 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="1dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/user_g" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:text="@string/home_person"
                                    android:textColor="#8CA5BD"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/textView_home_person_status_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_status_none"
                                    android:textColor="#19B394"
                                    android:textSize="12sp" />
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- E. Environment Monitoring Card 環境監測 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardView_home_environment"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#F1F7FF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#D8E3F0"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp">

                        <FrameLayout
                            android:id="@+id/frameLayout_home_environment_icon_background"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_circle_sky"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/temp_s"
                                app:tint="#1687E8" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/textView_home_environment_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/home_environment_monitoring"
                            android:textColor="#0B3D75"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/frameLayout_home_environment_icon_background"
                            app:layout_constraintStart_toEndOf="@id/frameLayout_home_environment_icon_background"
                            app:layout_constraintTop_toTopOf="@id/frameLayout_home_environment_icon_background" />

                        <!-- 小型趨勢/圖表 Icon -->
                        <ImageView
                            android:id="@+id/imageView_home_environment_trend"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_trend_chart"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textView_home_environment_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="#E8F5FF"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="1dp"
                            android:text="@string/home_location_kitchen"
                            android:textColor="#1687E8"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/frameLayout_home_environment_icon_background" />

                        <!-- 溫濕度數據 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            app:layout_constraintTop_toBottomOf="@id/textView_home_environment_location">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="3dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/temp_s"
                                    app:tint="#1687E8" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/home_temperature"
                                    android:textColor="#8CA5BD"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/textView_home_temperature_value"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:text="@string/home_temperature_preview"
                                    android:textColor="#0B3D75"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingVertical="3dp">
                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/humi_s"
                                    app:tint="#1687E8" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/home_humidity"
                                    android:textColor="#8CA5BD"
                                    android:textSize="12sp" />
                                <TextView
                                    android:id="@+id/textView_home_humidity_value"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:text="@string/home_humidity_preview"
                                    android:textColor="#1687E8"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 第二排：今日任務 與 今日任務列表 -->
            <LinearLayout
                android:id="@+id/linearLayout_home_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                app:layout_constraintTop_toBottomOf="@id/linearLayout_home_row1">

                <!-- F. Today Task Card 今日任務 (含環形進度條) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardView_home_today_task"
                    android:layout_width="0dp"
                    android:layout_height="190dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#F1FAF5"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#D8E9DF"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp">

                        <FrameLayout
                            android:id="@+id/frameLayout_home_task_icon_background"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_circle_green"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/task"
                                app:tint="@android:color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/textView_home_task_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/home_today_tasks"
                            android:textColor="#0B3D75"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/frameLayout_home_task_icon_background"
                            app:layout_constraintStart_toEndOf="@id/frameLayout_home_task_icon_background"
                            app:layout_constraintTop_toTopOf="@id/frameLayout_home_task_icon_background" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_arrow"
                            android:textColor="#19B394"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- 環形進度條區塊 -->
                        <FrameLayout
                            android:id="@+id/frameLayout_home_progress_container"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginTop="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/frameLayout_home_task_icon_background">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/circularProgressIndicator_home_task"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="0"
                                android:progress="0"
                                app:indicatorColor="#19B394"
                                app:indicatorSize="46dp"
                                app:trackColor="#E0F2F1"
                                app:trackThickness="4dp" />

                            <TextView
                                android:id="@+id/textView_home_progress_center_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text=""
                                android:textColor="#0B3D75"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <!-- 右側數據摘要 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="@id/frameLayout_home_progress_container"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/frameLayout_home_progress_container"
                            app:layout_constraintTop_toTopOf="@id/frameLayout_home_progress_container">

                            <TextView
                                android:id="@+id/textView_home_task_done"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#8CA5BD"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/textView_home_task_pending"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#8CA5BD"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/textView_home_task_rate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text=""
                                android:textColor="#19B394"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- G. Today Task List 今日任務列表 (支援 ScrollBar 的動態清單) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardView_home_task_list"
                    android:layout_width="0dp"
                    android:layout_height="190dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#F8F6FF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E4DFF0"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp">

                        <FrameLayout
                            android:id="@+id/frameLayout_home_list_icon_background"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_circle_purple"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/list_w"
                                app:tint="@android:color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/textView_home_list_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/home_today_task_list"
                            android:textColor="#0B3D75"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/frameLayout_home_list_icon_background"
                            app:layout_constraintStart_toEndOf="@id/frameLayout_home_list_icon_background"
                            app:layout_constraintTop_toTopOf="@id/frameLayout_home_list_icon_background" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_arrow"
                            android:textColor="#673AB7"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- 動態任務滾動清單 -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerView_home_tasks"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="8dp"
                            android:scrollbars="vertical"
                            android:fadeScrollbars="false"
                            android:scrollbarSize="3dp"
                            android:scrollbarThumbVertical="@android:color/darker_gray"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/frameLayout_home_list_icon_background"
                            tools:listitem="@layout/item_today_task" />

                        <TextView
                            android:id="@+id/textView_home_tasks_empty"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/home_tasks_empty"
                            android:textColor="@color/secondary_text"
                            android:textSize="12sp"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/frameLayout_home_list_icon_background"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ＝＝＝＝＝＝＝＝＝＝＝＝＝＝ H. Alert Summary 警報摘要 ＝＝＝＝＝＝＝＝＝＝＝＝＝＝ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView_home_alert"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFF4F5"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#F6DADD"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/linearLayout_home_row2">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imageView_home_alert_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/alert_rl"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView_home_alert_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#F0525C"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imageView_home_alert_icon"
                        app:layout_constraintTop_toTopOf="@id/imageView_home_alert_icon" />

                    <TextView
                        android:id="@+id/textView_home_alert_msg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/home_alert_none"
                        android:textColor="#8CA5BD"
                        android:textSize="11sp"
                        app:layout_constraintEnd_toStartOf="@id/textView_home_alert_arrow"
                        app:layout_constraintStart_toStartOf="@id/textView_home_alert_count"
                        app:layout_constraintTop_toBottomOf="@id/textView_home_alert_count" />

                    <TextView
                        android:id="@+id/textView_home_alert_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_arrow"
                        android:textColor="#F0525C"
                        android:textSize="18sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
