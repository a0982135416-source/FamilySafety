<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E88E5">

    <!-- ========================================================= -->
    <!-- 01. 頂部 Header 區域                                       -->
    <!-- 包含：返回按鈕、頁面標題                                     -->
    <!-- ========================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout_reset_header"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="#1E88E5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- [元件] 返回箭頭按鈕 -->
        <TextView
            android:id="@+id/textView_reset_back_arrow"
            android:layout_width="44dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="←"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- [元件] Header 標題文字 -->
        <TextView
            android:id="@+id/textView_reset_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="設定新密碼"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/textView_reset_back_arrow"
            app:layout_constraintStart_toEndOf="@id/textView_reset_back_arrow"
            app:layout_constraintTop_toTopOf="@id/textView_reset_back_arrow" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ========================================================= -->
    <!-- 02. 主要內容捲動區 (NestedScrollView)                       -->
    <!-- 確保內容在小螢幕上可捲動，背景色與底圖融合                     -->
    <!-- ========================================================= -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView_reset_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/constraintLayout_reset_header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FCFF">

            <!-- [元件] 頂部鎖頭插圖 -->
            <ImageView
                android:id="@+id/imageView_reset_lock_illustration"
                android:layout_width="240dp"
                android:layout_height="120dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/reset_password"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- [元件] 建立新密碼標題文字 -->
            <TextView
                android:id="@+id/textView_reset_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:text="建立您的新密碼"
                android:textColor="#1A4375"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imageView_reset_lock_illustration" />

            <!-- [元件] 重設密碼說明文字 -->
            <TextView
                android:id="@+id/textView_reset_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:text="請妥善保管您的新密碼，切勿洩漏給他人。"
                android:textColor="#5A7D9A"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView_reset_title" />

            <!-- ===================================================== -->
            <!-- 03. 新密碼輸入卡片區域                                  -->
            <!-- ===================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView_reset_new_password"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView_reset_desc"
                app:strokeColor="#B8D9F5"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- [元件] 欄位小圖示 -->
                    <ImageView
                        android:id="@+id/imageView_reset_new_password_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/lock"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- [元件] 欄位標題文字 -->
                    <TextView
                        android:id="@+id/textView_reset_new_password_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="新密碼"
                        android:textColor="#1A4375"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/imageView_reset_new_password_icon"
                        app:layout_constraintStart_toEndOf="@id/imageView_reset_new_password_icon"
                        app:layout_constraintTop_toTopOf="@id/imageView_reset_new_password_icon" />

                    <!-- [元件] 密碼輸入框 (含隱藏/顯示功能) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textInputLayout_reset_new_password"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#E0E0E0"
                        app:hintEnabled="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imageView_reset_new_password_icon"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#5A7D9A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editText_reset_new_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="請輸入新密碼"
                            android:inputType="textPassword"
                            android:textColor="#1A4375"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== -->
            <!-- 04. 確認新密碼卡片區域                                  -->
            <!-- ===================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView_reset_confirm_password"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardView_reset_new_password"
                app:strokeColor="#B8D9F5"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- [元件] 欄位小圖示 -->
                    <ImageView
                        android:id="@+id/imageView_reset_confirm_password_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/lock"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- [元件] 欄位標題文字 -->
                    <TextView
                        android:id="@+id/textView_reset_confirm_password_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="確認新密碼"
                        android:textColor="#1A4375"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/imageView_reset_confirm_password_icon"
                        app:layout_constraintStart_toEndOf="@id/imageView_reset_confirm_password_icon"
                        app:layout_constraintTop_toTopOf="@id/imageView_reset_confirm_password_icon" />

                    <!-- [元件] 確認密碼輸入框 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textInputLayout_reset_confirm_password"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#E0E0E0"
                        app:hintEnabled="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imageView_reset_confirm_password_icon"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#5A7D9A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editText_reset_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="請再次輸入新密碼"
                            android:inputType="textPassword"
                            android:textColor="#1A4375"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== -->
            <!-- 05. 密碼規則提示卡片區域                                -->
            <!-- ===================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView_reset_password_rules"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#E8F5FF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardView_reset_confirm_password">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- [元件] 提示圖示 (ⓘ) -->
                    <TextView
                        android:id="@+id/textView_reset_rule_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="ⓘ"
                        android:textColor="#1E88E5"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- [元件] 規則說明文字 -->
                    <TextView
                        android:id="@+id/textView_reset_rule_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="密碼必須包含 6-12 位英數字組合，\n且不得與舊密碼相同。"
                        android:textColor="#1E88E5"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/textView_reset_rule_icon"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== -->
            <!-- 06. 底部操作按鈕                                       -->
            <!-- ===================================================== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_reset_submit"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="#1E88E5"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="重設密碼"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardView_reset_password_rules" />

            <!-- ===================================================== -->
            <!-- 07. 底部裝飾背景圖                                     -->
            <!-- ===================================================== -->
            <ImageView
                android:id="@+id/imageView_reset_bottom_decor"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/reset_password_botton"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/button_reset_submit"
                app:layout_constraintVertical_bias="1.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>